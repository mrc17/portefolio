---
import type { ComponentProps } from 'astro/types';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { profile, whatsappUrl } from '../data/profile';

type Props = ComponentProps<typeof BaseLayout>;

const { title, description, ogType, schema } = Astro.props;

const navLinks = [
    { href: '/', label: 'Accueil' },
    { href: '/projets/', label: 'Projets' },
    { href: '/articles/', label: 'Articles' },
    { href: '/a-propos/', label: 'À propos' },
];

const expertiseLinks = (await getCollection('expertises')).map((expertise) => ({
    href: `/expertises/${expertise.id}/`,
    label: expertise.data.title,
}));
---

<BaseLayout title={title} description={description} ogType={ogType} schema={schema}>
    <div class="flex min-h-screen flex-col">
        <a
            href="#contenu"
            class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#04201c]"
        >
            Aller au contenu
        </a>

        <header class="sticky top-0 z-30 border-b border-edge bg-base/80 backdrop-blur">
            <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
                <a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight text-white">
                    <span class="text-accent">&#47;&#47;</span>{profile.name}
                </a>

                <nav aria-label="Navigation principale" class="hidden items-center gap-7 text-sm font-medium text-slate-400 sm:flex">
                    {navLinks.map((link) => (
                        <a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
                    ))}
                    <a href="/contact/" class="btn-primary px-4 py-2">Contact</a>
                </nav>

                <button
                    type="button"
                    id="menu-toggle"
                    class="text-slate-300 sm:hidden"
                    aria-label="Ouvrir le menu"
                    aria-expanded="false"
                    aria-controls="mobile-menu"
                >
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            <nav
                id="mobile-menu"
                aria-label="Navigation mobile"
                class="hidden flex-col gap-2 border-t border-edge px-6 py-4 text-sm font-medium text-slate-300 sm:hidden"
            >
                {[...navLinks, { href: '/contact/', label: 'Contact' }].map((link) => (
                    <a href={link.href} class="py-1 transition-colors hover:text-accent">{link.label}</a>
                ))}
            </nav>
        </header>

        <main id="contenu" class="flex-1">
            <slot />
        </main>

        <footer class="border-t border-edge bg-surface-2">
            <div class="mx-auto max-w-5xl px-6 py-10 text-sm text-slate-400">
                <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
                    <div>
                        <p class="font-semibold text-white">{profile.fullName}</p>
                        <p class="mt-1 max-w-xs">
                            Développeur Full Stack &amp; Lead Tech — Abidjan, Côte d'Ivoire.
                        </p>
                        <div class="mt-3 flex flex-wrap gap-4 font-mono text-xs">
                            <a
                                href={whatsappUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[#25D366] transition-colors hover:text-[#4ade80]"
                            >
                                WhatsApp
                            </a>
                            {profile.socials.map((social) => (
                                <a
                                    href={social.url}
                                    target="_blank"
                                    rel="noopener noreferrer me"
                                    class="text-slate-400 transition-colors hover:text-accent"
                                >
                                    {social.label}
                                </a>
                            ))}
                        </div>
                    </div>

                    <nav aria-label="Expertises">
                        <p class="eyebrow">Expertises</p>
                        <ul class="mt-3 space-y-1">
                            {expertiseLinks.map((link) => (
                                <li><a href={link.href} class="transition-colors hover:text-accent">{link.label}</a></li>
                            ))}
                        </ul>
                    </nav>
                </div>

                <p class="mt-10 border-t border-edge pt-6 font-mono text-xs text-slate-400">
                    © {new Date().getFullYear()} {profile.name}. Tous droits réservés.
                </p>
            </div>
        </footer>
    </div>
</BaseLayout>
