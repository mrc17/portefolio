---
import { getCollection, render } from 'astro:content';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { personId } from '../../data/profile';

export async function getStaticPaths() {
    const articles = await getCollection('articles');
    return articles.map((article) => ({
        params: { slug: article.id },
        props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, excerpt, publishedAt } = article.data;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
    {
        '@type': 'BlogPosting',
        headline: title,
        description: excerpt,
        datePublished: publishedAt.toISOString(),
        url: canonical,
        mainEntityOfPage: canonical,
        author: { '@id': personId(Astro.site!) },
        publisher: { '@id': personId(Astro.site!) },
        inLanguage: 'fr',
    },
];
---

<PublicLayout title={title} description={excerpt} ogType="article" schema={schema}>
    <article class="mx-auto max-w-3xl px-6 py-16">
        <a href="/articles/" class="font-mono text-sm text-slate-400 transition-colors hover:text-accent">&#8592; articles</a>
        <time class="mt-6 block font-mono text-xs text-slate-400">
            {publishedAt.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white">{title}</h1>

        <div class="prose prose-invert prose-slate mt-10 max-w-none prose-a:text-accent">
            <Content />
        </div>
    </article>
</PublicLayout>
