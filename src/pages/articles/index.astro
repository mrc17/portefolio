---
import { getCollection } from 'astro:content';
import PublicLayout from '../../layouts/PublicLayout.astro';

const articles = (await getCollection('articles')).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<PublicLayout
    title="Articles"
    description="Tutoriels, analyses et retours d'expérience sur Laravel, React, l'architecture logicielle et la sécurité applicative."
>
    <section class="mx-auto max-w-3xl px-6 py-16">
        <p class="eyebrow">// blog</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white">Articles</h1>
        <p class="mt-3 text-slate-400">Retours d'expérience et analyses techniques.</p>

        {articles.length === 0 ? (
            <p class="mt-10 font-mono text-sm text-slate-400">// les premiers articles arrivent prochainement</p>
        ) : (
            <div class="mt-10 divide-y divide-edge">
                {articles.map((article) => (
                    <a href={`/articles/${article.id}/`} class="group block py-6">
                        <h2 class="text-lg font-semibold text-white transition-colors group-hover:text-accent">{article.data.title}</h2>
                        <p class="mt-2 text-sm text-slate-400">{article.data.excerpt}</p>
                    </a>
                ))}
            </div>
        )}
    </section>
</PublicLayout>
