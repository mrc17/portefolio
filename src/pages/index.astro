---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PublicLayout from '../layouts/PublicLayout.astro';
import ProjectLogo from '../components/ProjectLogo.astro';
import TechTag from '../components/TechTag.astro';
import photo from '../assets/axel-toure.jpg';
import { profile } from '../data/profile';

const skills = [
    'Laravel',
    'React',
    'Java / Spring Boot',
    'Intégration de paiements',
    'IA / Biométrie',
    'Automatisation & tests',
    'Audit OWASP',
];

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
    .sort((a, b) => a.data.order - b.data.order)
    .slice(0, 3);

const expertises = await getCollection('expertises');
---

<PublicLayout
    title="Développeur Full Stack & Lead Tech à Abidjan"
    description="Axel Touré, développeur Full Stack & Lead Tech à Abidjan : applications web, API et plateformes métier en Laravel, React et Java. 5+ ans d'expérience."
>
    <section class="hero-glow grid-bg border-b border-edge">
        <div class="relative z-10 mx-auto max-w-5xl px-6 py-24">
            <div class="flex flex-col-reverse items-start gap-10 sm:flex-row sm:items-center sm:justify-between">
                <div class="max-w-2xl">
                    <p class="eyebrow">~/ {profile.fullName}</p>
                    <h1 class="mt-4 text-4xl font-bold tracking-tight text-white sm:text-5xl">
                        <span class="sr-only">Développeur Full Stack &amp; Lead Tech</span>
                        <span class="relative block" aria-hidden="true">
                            <span class="invisible">Développeur Full Stack &amp; Lead Tech</span>
                            <span class="absolute inset-0">
                                <span data-typewriter>Développeur Full Stack &amp; Lead Tech</span><span class="type-caret"></span>
                            </span>
                        </span>
                        <span class="mt-3 block text-xl font-medium text-slate-400 sm:text-2xl">
                            5+ ans d'expérience — Abidjan
                        </span>
                    </h1>
                    <script is:inline>setupTypewriter();</script>
                    <p class="mt-6 max-w-xl text-lg text-slate-400">
                        Je conçois et développe des applications web, des API et des
                        plateformes métier — y compris des systèmes critiques du secteur
                        public — avec une attention particulière portée à l'architecture,
                        à la qualité logicielle et à la sécurité.
                    </p>

                    <div class="mt-6 flex flex-wrap gap-2">
                        {skills.map((skill) => (
                            <TechTag tech={skill} />
                        ))}
                    </div>

                    <div class="mt-10 flex flex-wrap gap-4">
                        <a href="/contact/" class="btn-primary">Me contacter</a>
                        <a href="/projets/" class="btn-ghost">Voir mes réalisations</a>
                    </div>
                </div>

                <div class="hero-anim relative shrink-0" style="--anim-delay: 120ms">
                    <div class="absolute -inset-3 rounded-full bg-accent/10 blur-xl"></div>
                    <Image
                        src={photo}
                        alt="Touré WAOGNEINLIN Axel, développeur Full Stack à Abidjan"
                        class="relative h-40 w-40 rounded-full object-cover ring-2 ring-accent/40 sm:h-48 sm:w-48"
                        width={192}
                        height={192}
                        densities={[1.5, 2]}
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
            </div>
        </div>
    </section>

    <section class="reveal bg-surface-2">
        <div class="mx-auto max-w-5xl px-6 py-16">
            <p class="eyebrow">// réalisations</p>
            <h2 class="mt-2 text-2xl font-semibold text-white">Projets récents</h2>

            <div class="mt-8 grid gap-6 sm:grid-cols-3">
                {featuredProjects.map((project, i) => (
                    <a
                        href={`/projets/${project.id}/`}
                        class="reveal card card-lift block p-6"
                        style={`--reveal-delay: ${i * 90}ms`}
                    >
                        <ProjectLogo slug={project.id} title={project.data.title} class="h-12 w-12" />
                        <h3 class="mt-4 font-semibold text-white">{project.data.title}</h3>
                        <p class="mt-2 text-sm text-slate-400">{project.data.summary}</p>
                    </a>
                ))}
            </div>

            <a href="/projets/" class="mt-8 inline-flex items-center gap-1 font-mono text-sm text-accent transition-colors hover:text-accent-soft">
                Voir les {allProjects.length} réalisations <span aria-hidden="true">&#8594;</span>
            </a>
        </div>
    </section>

    <section class="reveal mx-auto max-w-5xl px-6 py-16">
        <p class="eyebrow">// expertises</p>
        <h2 class="mt-2 text-2xl font-semibold text-white">Ce que je fais</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {expertises.map((expertise, i) => (
                <a
                    href={`/expertises/${expertise.id}/`}
                    class="reveal card card-lift block p-6"
                    style={`--reveal-delay: ${i * 90}ms`}
                >
                    <h3 class="font-semibold text-white">{expertise.data.title}</h3>
                    <p class="mt-2 text-sm text-slate-400">{expertise.data.description}</p>
                </a>
            ))}
        </div>
    </section>
</PublicLayout>
